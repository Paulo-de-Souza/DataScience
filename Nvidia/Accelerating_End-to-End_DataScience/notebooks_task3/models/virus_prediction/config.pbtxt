backend: "fil"
max_batch_size: 32768
input [                                 
 {  
    name: "input__0"
    data_type: TYPE_FP32
    dims: [ 4 ]                    
  } 
]
output [
 {
    name: "output__0"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
instance_group [{ kind: KIND_GPU }]
parameters [
  {
    key: "model_type"
    value: { string_value: "xgboost_json" }
  },
  {
    key: "output_class"
    value: { string_value: "false" }
  },
  {
    key: "storage_type"
    value: { string_value: "AUTO" }
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 100
}